{
  "datasets": [
    {
      "name": "daa9ad9c",
      "displayName": "team performance",
      "queryLines": [
        "SELECT\n",
        "    season,\n",
        "\n",
        "    CONCAT(\n",
        "        CAST(season AS STRING),\n",
        "        '-',\n",
        "        RIGHT(CAST(season + 1 AS STRING), 2)\n",
        "    ) AS season_label,\n",
        "\n",
        "    team_id,\n",
        "    team_name,\n",
        "    conference,\n",
        "\n",
        "    games_played,\n",
        "    wins,\n",
        "    losses,\n",
        "    home_wins,\n",
        "    away_wins,\n",
        "\n",
        "    ROUND(win_pct * 100, 1) AS win_pct_percent,\n",
        "\n",
        "    points_per_game,\n",
        "    points_allowed_per_game,\n",
        "    point_differential,\n",
        "\n",
        "    ROUND(\n",
        "        point_differential / games_played,\n",
        "        2\n",
        "    ) AS avg_point_margin\n",
        "\n",
        "FROM nba_analytics.gold.team_season\n",
        "\n",
        "WHERE season IN (2023, 2024)\n",
        "  AND season_type = 'regular'"
      ]
    }
  ],
